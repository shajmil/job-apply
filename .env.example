DATABASE_URL=postgresql://postgres:postgres@localhost:5432/job_agent
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
APPLICATION_SENDING_ENABLED=false
MAX_APPLICATIONS_PER_DAY=10
RESUME_PATH=
APPLICANT_EMAIL_ADDRESS=
NOTIFY_GMAIL_ADDRESS=
NOTIFY_GMAIL_APP_PASSWORD=
NOTIFY_RECIPIENT_ADDRESS=
DIGEST_ENABLED=false
DASHBOARD_TOKEN=
PORT=3000
GREENHOUSE_COMPANIES=particle41llc,encora10,envoyglobalinc,capco,tide
LEVER_COMPANIES=smart-working-solutions
# Kerala IT park job portals (Infopark: Kochi/Thrissur/Cherthala, Technopark: Thiruvananthapuram)
INFOPARK_ENABLED=true
TECHNOPARK_ENABLED=true
# Keyword-matched job pages from public sitemaps; leave empty to disable a source
CUTSHORT_KEYWORDS=angular
HIRIST_KEYWORDS=angular
STRUCTURED_SOURCE_MAX_JOBS=30
HIRIST_MAX_JOBS=15
# Company career pages that publish schema.org JobPosting data, comma-separated https URLs
CAREER_PAGES=
CAREER_PAGES_RENDER=false
CAREER_PAGE_MAX_LINKS=30
# Chrome or Edge used for Hirist and rendered career pages; detected automatically when unset
BROWSER_EXECUTABLE_PATH=
RUN_ON_STARTUP=false
CRON_SCHEDULE=0 9 * * *
LLM_INPUT_USD_PER_MILLION=3
LLM_OUTPUT_USD_PER_MILLION=15
# Optional JSON exports of LinkedIn/Naukri jobs, processed on each discovery run.
# Each file contains an array of applyUrl, companyName, roleTitle, locationText, jobDescription.
JOB_BOARD_IMPORT_FILES=
